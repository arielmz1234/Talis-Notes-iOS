    "everything_in_one_file_notebooks_pictures": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything in one file: notebooks, pictures, pens, colours and your shapes. Keep it in Files, on a computer, or send it to yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo en un archivo: cuadernos, imágenes, bolígrafos, colores y tus formas. Guárdalo en Archivos, en un ordenador o envíatelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout dans un seul fichier : carnets, images, stylos, couleurs et vos formes. Gardez-le dans Fichiers, sur un ordinateur, ou envoyez-le-vous."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo num só arquivo: cadernos, imagens, canetas, cores e suas formas. Guarde em Arquivos, num computador, ou envie para você mesmo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء في ملف واحد: الدفاتر والصور والأقلام والألوان وأشكالك. احتفظ به في «الملفات» أو على حاسوب، أو أرسله لنفسك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכול בקובץ אחד: מחברות, תמונות, עטים, צבעים והצורות שלך. אפשר לשמור אותו בקבצים, במחשב, או לשלוח לעצמך."
          }
        }
      }
    },
    "everything_in_the_backup_was_already": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything in the backup was already here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo de la copia ya estaba aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le contenu de la sauvegarde était déjà là."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que estava no backup já estava aqui."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما في النسخة الاحتياطية موجود هنا بالفعل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל מה שבגיבוי כבר היה כאן."
          }
        }
      }
    },
    "everything_on_it_is_removed_undo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything on it is removed. Undo brings it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se quita todo lo que hay en ella. Deshacer lo recupera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qu'elle contient est retiré. Annuler le fait revenir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que há nela é removido. Desfazer traz de volta."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُزال كل ما عليها. التراجع يعيده."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל מה שעליו יימחק. ביטול הפעולה מחזיר אותו."
          }
        }
      }
    },
    "everything_on_one_long_page_sized": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything on one long page, sized to fit, instead of A4 pages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo en una sola página larga, ajustada al contenido, en lugar de páginas A4."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout sur une seule longue page, à la taille du contenu, au lieu de pages A4."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo numa única página longa, no tamanho do conteúdo, em vez de páginas A4."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء في صفحة واحدة طويلة على قدر المحتوى، بدلًا من صفحات A4."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכול בעמוד ארוך אחד בגודל המתאים, במקום עמודי A4."
          }
        }
      }
    },
    "everything_on_them_is_removed_and": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything on them is removed and one empty page stays. Undo brings it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se quita todo lo que hay en ellas y queda una página vacía. Deshacer lo recupera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qu'elles contiennent est retiré et il reste une page vide. Annuler le fait revenir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que há nelas é removido e fica uma página vazia. Desfazer traz de volta."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُزال كل ما عليها وتبقى صفحة فارغة واحدة. التراجع يعيده."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל מה שעליהם יימחק ויישאר עמוד ריק אחד. ביטול הפעולה מחזיר אותם."
          }
        }
      }
    },
    "export_pdf": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export PDF"
          }
        },
        "es": {
