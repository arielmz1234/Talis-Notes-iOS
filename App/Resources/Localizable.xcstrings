    "tip_at_the_end_of_a": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: at the end of a line or shape, hold the pen still and it snaps clean"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo: al final de una línea o forma, deja el lápiz quieto y se ajusta limpia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Astuce : à la fin d'un trait ou d'une forme, gardez le stylet immobile et il devient net"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: no fim de uma linha ou forma, segure a caneta parada e ela fica perfeita"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نصيحة: في نهاية خط أو شكل، أبقِ القلم ثابتًا فيستقيم الشكل"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טיפ: בסוף קו או צורה, משאירים את העט במקום והיא מתיישרת"
          }
        }
      }
    },
    "tip_hold_the_s_pen_button": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: hold the S Pen button to erase with any tool."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo: mantén pulsado el botón del S Pen para borrar con cualquier herramienta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Astuce : maintenez le bouton du S Pen pour effacer avec n'importe quel outil."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: segure o botão da S Pen para apagar com qualquer ferramenta."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نصيحة: اضغط مطولًا على زر S Pen للمسح بأي أداة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טיפ: לחיצה ממושכת על כפתור ה-S Pen מוחקת עם כל כלי."
          }
        }
      }
    },
    "tip_hold_the_s_pen_s": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: hold the S Pen's side button to erase, and let go to keep writing"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo: mantén pulsado el botón lateral del S Pen para borrar y suéltalo para seguir escribiendo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Astuce : maintenez le bouton latéral du S Pen pour effacer, et relâchez pour continuer à écrire"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: segure o botão lateral da S Pen para apagar e solte para continuar escrevendo"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نصيحة: اضغط مطولًا على الزر الجانبي لـ S Pen للمسح، وأفلته لمتابعة الكتابة"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טיפ: לוחצים על הכפתור בצד ה-S Pen כדי למחוק, ועוזבים כדי להמשיך לכתוב"
          }
        }
      }
    },
    "tips_and_tricks": {
      "extractionState": "manual",
      "localizations": {
