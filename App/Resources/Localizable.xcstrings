    "star_a_subject_to_keep_its": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Star a subject to keep its shapes in the Shapes panel; holding the pen at the end of a stroke snaps to them too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca una materia con estrella para tener sus formas en el panel de Formas; al mantener el lápiz quieto al final de un trazo también se ajusta a ellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez une étoile à une matière pour garder ses formes dans le panneau Formes ; garder le stylet immobile à la fin d'un trait s'y ajuste aussi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque uma matéria com estrela para ter as formas dela no painel Formas; segurar a caneta parada no fim de um traço também encaixa nelas."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع نجمة على مادة لتبقى أشكالها في لوحة الأشكال؛ وإبقاء القلم ثابتًا في نهاية خط يحوّله إليها أيضًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסמנים תחום בכוכב כדי שהצורות שלו יופיעו בלוח הצורות; לחיצה ממושכת בסוף קו תיישר אליהן גם."
          }
        }
      }
    },
    "star_this_pen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Star this pen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
