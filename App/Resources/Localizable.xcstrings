    "into_which_notebook": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Into which notebook?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿En qué cuaderno?"
          }
        },
        "fr": {
          "stringUnit": {
