    "starred_double_press_the_s_pen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starred. Double-press the S Pen button to switch to the next starred pen, or triple-press to go back"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcado. Pulsa dos veces el botón del S Pen para pasar al siguiente bolígrafo con estrella, o tres veces para volver"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouté aux favoris. Appuyez deux fois sur le bouton du S Pen pour passer au stylo favori suivant, ou trois fois pour revenir"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcada. Pressione duas vezes o botão da S Pen para ir à próxima caneta com estrela, ou três vezes para voltar"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مميّز بنجمة. اضغط زر S Pen مرتين للانتقال إلى القلم المميّز التالي، أو ثلاث مرات للرجوع"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סומן בכוכב. לחיצה כפולה על כפתור ה-S Pen עוברת לעט המסומן הבא, ולחיצה משולשת חוזרת"
          }
        }
      }
    },
    "starred_notebooks": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
