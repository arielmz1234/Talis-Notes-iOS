    "n_isn_t_in_your_notebooks": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” isn't in your notebooks. Save it to keep it and write on it, or leave and it won't be kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» no está en tus cuadernos. Guárdalo para conservarlo y escribir en él, o sal y no se guardará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » n'est pas dans vos carnets. Enregistrez-le pour le garder et écrire dessus, sinon il ne sera pas conservé."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” não está nos seus cadernos. Salve para guardar e escrever nele, ou saia e ele não será guardado."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» ليس ضمن دفاترك. احفظه للاحتفاظ به والكتابة عليه، أو اخرج ولن يُحتفظ به."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\" לא נמצא במחברות שלך. אפשר לשמור אותו כדי לכתוב עליו, או לצאת והוא לא יישמר."
          }
        }
      }
    },
    "n_items_locked_hold_one_to": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ items locked — hold one to unlock it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ elementos bloqueados: mantén pulsado uno para desbloquearlo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ éléments verrouillés : maintenez-en un pour le déverrouiller"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ itens travados: toque e segure um para destravá-lo"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم قفل %1$@ عناصر — اضغط مطولًا على أحدها لفتحه"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ פריטים ננעלו — לחיצה ממושכת על אחד משחררת אותו"
          }
        }
      }
    },
