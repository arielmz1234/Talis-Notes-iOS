        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا المكان لا يسمح للتطبيقات بمواصلة الحفظ في ملف. جرّب Google Drive أو الجهاز."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המקום הזה לא מאפשר לאפליקציות לשמור לקובץ באופן קבוע. כדאי לנסות את Google Drive או את הטאבלט."
          }
        }
      }
    },
