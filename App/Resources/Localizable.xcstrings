          "stringUnit": {
            "state": "translated",
            "value": "Every backup in a folder on the tablet or a memory card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las copias de una carpeta de la tableta o una tarjeta de memoria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les sauvegardes d'un dossier de la tablette ou d'une carte mémoire."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
