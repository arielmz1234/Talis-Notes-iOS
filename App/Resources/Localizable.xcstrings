    "cam_allow_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is used only while this screen is open. Photos stay on this tablet."
          }
        },
        "es": {
          "stringUnit": {
