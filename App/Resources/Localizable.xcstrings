          }
        }
      }
    },
    "it_disappears_from_the_paper_choices": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It disappears from the paper choices. Notebooks using it switch to blank paper; your writing stays."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desaparece de los papeles disponibles. Los cuadernos que lo usan pasan a papel en blanco; tu escritura se queda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disparaît des choix de papier. Les carnets qui l'utilisent passent au papier blanc ; votre écriture reste."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele some das opções de papel. Os cadernos que o usam passam para papel em branco; sua escrita fica."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يختفي من خيارات الورق. الدفاتر التي تستخدمه تنتقل إلى ورق فارغ؛ وتبقى كتابتك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוא ייעלם מבחירת הדפים. מחברות שמשתמשות בו יעברו לדף ריק; הכתיבה נשארת."
          }
        }
      }
    },
    "it_goes_into_your_notebooks_ready": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It goes into your notebooks, ready to write on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Va a tus cuadernos, listo para escribir en él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il va dans vos carnets, prêt à être annoté."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele vai para seus cadernos, pronto para você escrever nele."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يذهب إلى دفاترك، جاهزًا للكتابة عليه."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוא נכנס למחברות שלך, מוכן לכתיבה."
          }
        }
      }
    },
    "it_ll_keep_backing_up_into": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " It'll keep backing up into that file by itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Seguirá haciendo copias en ese archivo por sí sola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " La sauvegarde continuera toute seule dans ce fichier."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " Ele vai continuar fazendo backup nesse arquivo sozinho."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": " سيواصل النسخ إلى هذا الملف تلقائيًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": " הגיבוי לקובץ הזה ימשיך מעצמו."
          }
        }
      }
    },
    "it_moves_to_recently_deleted_where": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It moves to Recently deleted, where you can bring it back for %1$@ days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa a Eliminados recientemente, donde puedes recuperarlo durante %1$@ días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il passe dans Supprimés récemment, où vous pouvez le récupérer pendant %1$@ jours."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele vai para Excluídos recentemente, onde você pode recuperá-lo por %1$@ dias."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينتقل إلى «المحذوفة مؤخرًا»، حيث يمكنك استعادته خلال %1$@ يومًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היא תעבור ל\"נמחקו לאחרונה\", ואפשר יהיה להחזיר אותה במשך %1$@ ימים."
          }
        }
      }
    },
    "it_will_appear_in_shapes_under": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It will appear in Shapes under My shapes, and holding the pen at the end of a similar stroke will snap to it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparecerá en Formas, en Mis formas, y al mantener el lápiz quieto al final de un trazo parecido se ajustará a ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle apparaîtra dans Formes, sous Mes formes, et garder le stylet immobile à la fin d'un trait semblable s'y ajustera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela vai aparecer em Formas, em Minhas formas, e segurar a caneta parada no fim de um traço parecido vai encaixá-lo nela."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيظهر في الأشكال ضمن «أشكالي»، وإبقاء القلم ثابتًا في نهاية خط مشابه سيحوّله إليه."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היא תופיע בצורות תחת \"הצורות שלי\", ולחיצה ממושכת בסוף קו דומה תיישר אליה."
          }
        }
      }
    },
    "it_will_no_longer_be_offered": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It will no longer be offered here or recognised when you hold the pen. Shapes already on your pages stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no aparecerá aquí ni se reconocerá al mantener el lápiz quieto. Las formas que ya están en tus páginas se quedan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle ne sera plus proposée ici ni reconnue quand vous maintenez le stylet. Les formes déjà sur vos pages restent."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela não será mais oferecida aqui nem reconhecida ao segurar a caneta. As formas que já estão nas suas páginas ficam."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يظهر هنا بعد الآن ولن يُتعرّف عليه عند إبقاء القلم ثابتًا. الأشكال الموجودة في صفحاتك تبقى."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היא לא תוצע כאן יותר ולא תזוהה בלחיצה ממושכת. צורות שכבר על העמודים נשארות."
          }
        }
      }
    },
