    "starred_star_another_pen_then_double": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starred. Star another pen, then double-press the S Pen button to switch to the next starred pen, or triple-press to go back"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcado. Marca otro bolígrafo con estrella y luego pulsa dos veces el botón del S Pen para pasar al siguiente, o tres veces para volver"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouté aux favoris. Mettez une étoile à un autre stylo, puis appuyez deux fois sur le bouton du S Pen pour passer au suivant, ou trois fois pour revenir"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcada. Marque outra caneta com estrela e depois pressione duas vezes o botão da S Pen para ir à próxima, ou três vezes para voltar"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مميّز بنجمة. ضع نجمة على قلم آخر، ثم اضغط زر S Pen مرتين للانتقال إلى التالي، أو ثلاث مرات للرجوع"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סומן בכוכב. אפשר לסמן עוד עט, ואז לחיצה כפולה על כפתור ה-S Pen עוברת לעט המסומן הבא, ולחיצה משולשת חוזרת"
          }
        }
      }
    },
