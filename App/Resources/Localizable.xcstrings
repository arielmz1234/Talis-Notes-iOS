    "feat_tidy_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lines lock to level, upright and 45° while you draw or turn them, and shapes snap to each other's edges, corners and middles. Turn snapping off in Shapes › Style."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las líneas se fijan en horizontal, vertical y 45° al dibujarlas o girarlas, y las formas se ajustan a los bordes, esquinas y centros de las demás. Desactiva el ajuste en Formas › Estilo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les traits se calent à l’horizontale, à la verticale et à 45° quand vous les tracez ou les tournez, et les formes s’aimantent aux bords, coins et milieux des autres. Désactivez l’aimantation dans Formes › Style."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As linhas travam na horizontal, na vertical e em 45° enquanto você desenha ou gira, e as formas se encaixam nas bordas, cantos e centros umas das outras. Desligue o encaixe em Formas › Estilo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تثبت الخطوط أفقيًا وعموديًا وعلى 45° أثناء رسمها أو تدويرها، وتلتصق الأشكال بحواف بعضها وزواياها ومنتصفاتها. أوقف المحاذاة من الأشكال › النمط."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קווים ננעלים לאופקי, אנכי ו-45° בזמן ציור או סיבוב, וצורות נצמדות לקצוות, לפינות ולאמצעים של צורות אחרות. מכבים את ההצמדה בצורות › סגנון."
          }
        }
      }
    },
