    "tour_spen_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the S Pen's button to erase with any tool. Star your favourite pens, then double-press the button to jump between them. Tap with two fingers to undo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado el botón del S Pen para borrar con cualquier herramienta. Marca tus bolígrafos favoritos con estrella y pulsa dos veces el botón para saltar entre ellos. Toca con dos dedos para deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez le bouton du S Pen pour effacer avec n'importe quel outil. Mettez une étoile à vos stylos préférés, puis appuyez deux fois sur le bouton pour passer de l'un à l'autre. Touchez avec deux doigts pour annuler."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure o botão da S Pen para apagar com qualquer ferramenta. Marque suas canetas favoritas com estrela e pressione o botão duas vezes para alternar entre elas. Toque com dois dedos para desfazer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا على زر S Pen للمسح بأي أداة. ضع نجمة على أقلامك المفضلة، ثم اضغط الزر مرتين للتنقل بينها. انقر بإصبعين للتراجع."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחיצה ממושכת על כפתור ה-S Pen מוחקת עם כל כלי. מסמנים עטים אהובים בכוכב, ולחיצה כפולה על הכפתור קופצת ביניהם. הקשה בשתי אצבעות מבטלת."
          }
        }
      }
    },
    "tour_spen_title": {
      "extractionState": "manual",
      "localizations": {
