    "draw_around_anything_to_take_a": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw around anything to take a picture of it: save it to your gallery, share it or copy it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodea cualquier cosa para hacerle una foto: guárdala en tu galería, compártela o cópiala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entourez n'importe quoi pour en faire une image : enregistrez-la dans votre galerie, partagez-la ou copiez-la."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contorne qualquer coisa para tirar uma foto dela: salve na galeria, compartilhe ou copie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أحِط بأي شيء لالتقاط صورة له: احفظها في المعرض أو شاركها أو انسخها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מקיפים כל דבר כדי לצלם אותו: לשמור בגלריה, לשתף או להעתיק."
          }
