          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרצאות ושקפים"
          }
        }
      }
    },
    "tour_write_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A4 pages that keep coming as you write. Pinch to zoom, slide with two fingers, and everything saves the moment you write it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Páginas A4 que van apareciendo mientras escribes. Pellizca para ampliar, desliza con dos dedos, y todo se guarda en cuanto lo escribes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des pages A4 qui s'ajoutent au fil de l'écriture. Pincez pour zoomer, faites glisser avec deux doigts, et tout est enregistré dès que vous l'écrivez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Páginas A4 que vão surgindo enquanto você escreve. Faça pinça para dar zoom, deslize com dois dedos, e tudo é salvo no momento em que você escreve."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صفحات A4 تتوالى أثناء الكتابة. قرّب بإصبعين للتكبير، واسحب بإصبعين للتمرير، ويُحفظ كل شيء لحظة كتابته."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עמודי A4 שממשיכים להגיע תוך כדי כתיבה. צובטים כדי להגדיל, גוללים בשתי אצבעות, והכול נשמר ברגע שכותבים."
          }
        }
      }
    },
    "tour_write_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write like on paper"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe como en papel"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrivez comme sur papier"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva como no papel"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب كما على الورق"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כותבים כמו על נייר"
          }
        }
      }
    },
    "trace_over_or_touch_anything_to": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trace over or touch anything to pick it up, or circle a group. Then move, resize, recolour or copy it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa por encima o toca cualquier cosa para seleccionarla, o rodea un grupo. Luego muévelo, cambia su tamaño o color, o cópialo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez sur n'importe quoi ou touchez-le pour le prendre, ou entourez un groupe. Puis déplacez-le, redimensionnez-le, changez sa couleur ou copiez-le."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe por cima ou toque em qualquer coisa para pegá-la, ou circule um grupo. Depois mova, redimensione, mude a cor ou copie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرّر فوق أي شيء أو المسه لتحديده، أو أحِط بمجموعة. ثم انقله أو غيّر حجمه أو لونه أو انسخه."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עוברים על כל דבר או נוגעים בו כדי לבחור, או מקיפים קבוצה. ואז מזיזים, משנים גודל, צובעים או מעתיקים."
          }
        }
      }
    },
