    "circle_anything_to_move_resize_recolour": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Circle anything to move, resize, recolour or copy it. Tap a single item with the lasso to pick just that one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodea cualquier cosa para moverla, cambiar su tamaño o color, o copiarla. Toca un solo elemento con el lazo para elegir solo ese."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entourez n'importe quoi pour le déplacer, le redimensionner, changer sa couleur ou le copier. Touchez un seul élément avec le lasso pour ne prendre que lui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Circule qualquer coisa para mover, redimensionar, mudar a cor ou copiar. Toque num único item com o laço para pegar só ele."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أحِط بأي شيء لنقله أو تغيير حجمه أو لونه أو نسخه. اضغط على عنصر واحد باللاسو لاختياره وحده."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מקיפים כל דבר כדי להזיז, לשנות גודל, לצבוע מחדש או להעתיק. הקשה על פריט אחד עם הלאסו בוחרת רק אותו."
          }
        }
      }
    },
