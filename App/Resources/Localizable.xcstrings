    "tap_inside_a_shape_or_inside": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap inside a shape, or inside an area you've drawn around, to fill it with colour. Your writing stays on top."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dentro de una forma, o dentro de una zona que hayas rodeado, para rellenarla de color. Tu escritura queda encima."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez l'intérieur d'une forme, ou d'une zone que vous avez entourée, pour la remplir de couleur. Votre écriture reste au-dessus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque dentro de uma forma, ou dentro de uma área que você contornou, para preenchê-la com cor. Sua escrita fica por cima."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط داخل شكل، أو داخل منطقة أحطت بها، لتعبئتها بلون. تبقى كتابتك فوقها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מקישים בתוך צורה, או בתוך אזור שהקפת, כדי לצבוע אותו. הכתיבה נשארת מעל."
          }
        }
      }
    },
