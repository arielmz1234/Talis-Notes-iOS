    "that_place_doesn_t_let_apps": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That place doesn't let apps keep saving to a file. Try Google Drive or the tablet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese lugar no deja que las apps sigan guardando en un archivo. Prueba con Google Drive o la tableta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet endroit ne permet pas aux applis d'enregistrer en continu dans un fichier. Essayez Google Drive ou la tablette."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse local não deixa os apps continuarem salvando num arquivo. Tente o Google Drive ou o tablet."
