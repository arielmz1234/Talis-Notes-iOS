    "they_move_to_recently_deleted_where": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They move to Recently deleted, where you can bring them back for %1$@ days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasan a Eliminados recientemente, donde puedes recuperarlos durante %1$@ días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils passent dans Supprimés récemment, où vous pouvez les récupérer pendant %1$@ jours."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eles vão para Excluídos recentemente, onde você pode recuperá-los por %1$@ dias."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتقل إلى «المحذوفة مؤخرًا»، حيث يمكنك استعادتها خلال %1$@ يومًا."
