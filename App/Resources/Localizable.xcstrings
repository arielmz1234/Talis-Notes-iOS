    "notebooks_stay_here_for_n_days": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notebooks stay here for %1$@ days, then they're deleted for good"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cuadernos se quedan aquí %1$@ días y luego se borran para siempre"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les carnets restent ici %1$@ jours, puis sont supprimés définitivement"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os cadernos ficam aqui por %1$@ dias e depois são apagados de vez"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى الدفاتر هنا %1$@ يومًا، ثم تُحذف نهائيًا"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחברות נשארות כאן %1$@ ימים, ואז נמחקות לצמיתות"
          }
        }
      }
    },
    "notebooks_you_open_show_up_here": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notebooks you open show up here, a tap away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cuadernos que abras aparecen aquí, a un toque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les carnets que vous ouvrez apparaissent ici, à portée de doigt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os cadernos que você abre aparecem aqui, a um toque."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر هنا الدفاتر التي تفتحها، على بُعد نقرة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחברות שפותחים מופיעות כאן, במרחק הקשה."
          }
        }
      }
    },
    "nothing_inside_is_deleted_its_notebooks": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing inside is deleted. Its notebooks and folders move up into “%1$@”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se borra nada de lo que contiene. Sus cuadernos y carpetas pasan a «%1$@»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à l'intérieur n'est supprimé. Ses carnets et dossiers remontent dans « %1$@ »."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada que está dentro é apagado. Os cadernos e pastas dela sobem para “%1$@”."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُحذف شيء مما بداخله. تنتقل دفاتره ومجلداته إلى «%1$@»."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שום דבר בפנים לא נמחק. המחברות והתיקיות שבה עוברות ל\"%1$@\"."
          }
        }
      }
    },
    "nothing_inside_is_deleted_its_notebooks_2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing inside is deleted. Its notebooks move back to All notebooks, and its folders to the top level."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se borra nada de lo que contiene. Sus cuadernos vuelven a Todos los cuadernos y sus carpetas al nivel superior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à l'intérieur n'est supprimé. Ses carnets reviennent dans Tous les carnets, et ses dossiers au premier niveau."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada que está dentro é apagado. Os cadernos dela voltam para Todos os cadernos, e as pastas para o nível principal."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُحذف شيء مما بداخله. تعود دفاتره إلى «كل الدفاتر»، ومجلداته إلى المستوى الأعلى."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שום דבר בפנים לא נמחק. המחברות שבה חוזרות ל\"כל המחברות\", והתיקיות לרמה העליונה."
          }
        }
      }
    },
    "nothing_on_this_tablet_is_deleted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing on this tablet is deleted: notebooks from the backup are added, and if a notebook is in both places, the newest version is kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se borra nada de esta tableta: se añaden los cuadernos de la copia y, si un cuaderno está en ambos sitios, se conserva la versión más reciente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est supprimé de cette tablette : les carnets de la sauvegarde sont ajoutés et, si un carnet est aux deux endroits, la version la plus récente est gardée."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada deste tablet é apagado: os cadernos do backup são adicionados e, se um caderno estiver nos dois lugares, a versão mais recente é mantida."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُحذف شيء من هذا الجهاز: تُضاف الدفاتر من النسخة الاحتياطية، وإذا كان الدفتر في المكانين، يُحتفظ بالنسخة الأحدث."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שום דבר בטאבלט לא נמחק: מחברות מהגיבוי מתווספות, ואם מחברת נמצאת בשני המקומות, נשמרת הגרסה החדשה ביותר."
          }
        }
      }
    },
