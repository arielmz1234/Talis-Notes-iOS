    "every_stroke_is_saved_the_moment": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every stroke is saved the moment you write it, even without internet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada trazo se guarda en el momento en que lo escribes, incluso sin internet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque trait est enregistré dès que vous l'écrivez, même sans internet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada traço é salvo no momento em que você escreve, mesmo sem internet."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل خط يُحفظ لحظة كتابته، حتى من دون إنترنت."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל קו נשמר ברגע שכותבים אותו, גם בלי אינטרנט."
          }
        }
      }
    },
    "everything": {
      "extractionState": "manual",
      "localizations": {
