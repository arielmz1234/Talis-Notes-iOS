        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft cloud edges on bars and cards, and clouds drifting across the sky."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bordes de nube suaves en barras y tarjetas, y nubes que cruzan el cielo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bords en nuage doux sur les barres et les cartes, et des nuages qui traversent le ciel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bordas suaves de nuvem nas barras e nos cartões, e nuvens passando pelo céu."
          }
