    "to_move_them_or_unlock_them": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To move them or unlock them. Off, the lasso leaves locked items alone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para moverlos o desbloquearlos. Desactivado, el lazo no toca los elementos bloqueados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les déplacer ou les déverrouiller. Désactivé, le lasso ignore les éléments verrouillés."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para movê-los ou destravá-los. Desativado, o laço deixa os itens travados de lado."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لنقلها أو فتحها. عند الإيقاف، يتجاهل اللاسو العناصر المقفلة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להזיז או לשחרר אותם. כשכבוי, הלאסו לא נוגע בפריטים נעולים."
          }
        }
      }
    },
    "to_record_voice_memos_allow_the": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To record voice memos, allow the microphone for Tali's Notes in the tablet's settings"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para grabar notas de voz, permite el micrófono para Tali's Notes en los ajustes de la tableta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour enregistrer des mémos vocaux, autorisez le micro pour Tali's Notes dans les réglages de la tablette"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para gravar notas de voz, permita o microfone para o Tali's Notes nas configurações do tablet"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتسجيل المذكرات الصوتية، اسمح بالميكروفون لـ Tali's Notes في إعدادات الجهاز"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להקליט, צריך לאפשר ל-Tali's Notes גישה למיקרופון בהגדרות הטאבלט"
          }
        }
      }
    },
    "too_short_to_keep": {
