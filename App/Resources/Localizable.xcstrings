    "a4_pages_that_keep_coming_as": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A4 pages that keep coming as you write. Everything saves as you go."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Páginas A4 que van apareciendo mientras escribes. Todo se guarda sobre la marcha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des pages A4 qui s'ajoutent au fil de l'écriture. Tout est enregistré au fur et à mesure."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Páginas A4 que vão surgindo enquanto você escreve. Tudo é salvo na hora."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صفحات A4 تتوالى أثناء الكتابة. يُحفظ كل شيء أولًا بأول."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עמודי A4 שממשיכים להתווסף תוך כדי כתיבה. הכול נשמר אוטומטית."
          }
        }
      }
    },
    "a_black_page_your_pens_switch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A black page; your pens switch to light colours"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una página negra; tus bolígrafos pasan a colores claros"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une page noire ; vos stylos passent aux couleurs claires"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma página preta; suas canetas mudam para cores claras"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صفحة سوداء؛ تتحول أقلامك إلى ألوان فاتحة"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דף שחור; העטים עוברים לצבעים בהירים"
          }
        }
      }
    },
