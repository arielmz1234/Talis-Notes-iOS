    "draw_a_shape_you_use_a": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw a shape you use a lot, circle it with the lasso and tap “Save as shape”. Holding the pen at the end of a stroke will then snap to it too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja una forma que uses mucho, rodéala con el lazo y toca «Guardar como forma». Al mantener el lápiz quieto al final de un trazo, también se ajustará a ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessinez une forme que vous utilisez souvent, entourez-la au lasso et touchez « Enregistrer comme forme ». En gardant le stylet immobile à la fin d'un trait, il s'y ajustera aussi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhe uma forma que você usa muito, circule-a com o laço e toque em “Salvar como forma”. Segurar a caneta parada no fim de um traço também vai encaixá-lo nela."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارسم شكلًا تستخدمه كثيرًا، وأحِط به باللاسو، ثم اضغط «حفظ كشكل». بعدها، إبقاء القلم ثابتًا في نهاية خط سيحوّله إليه أيضًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציירים צורה שמשתמשים בה הרבה, מקיפים אותה בלאסו ומקישים \"שמירה כצורה\". לחיצה ממושכת בסוף קו תיישר אליה גם כן."
          }
        }
      }
    },
    "draw_around_an_area_first_or": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw around an area first, or tap inside a shape"
