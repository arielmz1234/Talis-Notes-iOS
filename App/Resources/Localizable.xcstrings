    "clean_edges_on_bars_and_cards": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clean edges on bars and cards, no clouds in the sky, and more room at the top."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bordes limpios en barras y tarjetas, sin nubes en el cielo y más espacio arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bords nets sur les barres et les cartes, pas de nuages dans le ciel, et plus de place en haut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bordas limpas nas barras e nos cartões, sem nuvens no céu e mais espaço no topo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حواف بسيطة للأشرطة والبطاقات، بلا غيوم في السماء، ومساحة أكبر في الأعلى."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שוליים נקיים לסרגלים ולכרטיסים, בלי עננים בשמיים, ויותר מקום למעלה."
          }
        }
      }
    },
