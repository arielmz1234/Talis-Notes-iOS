    "this_backup_was_made_by_a": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This backup was made by a newer version of Tali's Notes. Update the app first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia se hizo con una versión más nueva de Tali's Notes. Actualiza la app primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sauvegarde a été faite avec une version plus récente de Tali's Notes. Mettez d'abord l'appli à jour."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
