    "opens_on_any_computer_or_phone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens on any computer or phone, without the app. Uses more space and takes longer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abre en cualquier ordenador o teléfono, sin la app. Ocupa más espacio y tarda más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'ouvre sur n'importe quel ordinateur ou téléphone, sans l'appli. Prend plus de place et plus de temps."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre em qualquer computador ou celular, sem o app. Ocupa mais espaço e demora mais."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُفتح على أي حاسوب أو هاتف، من دون التطبيق. يشغل مساحة أكبر ويستغرق وقتًا أطول."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נפתח בכל מחשב או טלפון, בלי האפליקציה. תופס יותר מקום ולוקח יותר זמן."
          }
        }
      }
    },
