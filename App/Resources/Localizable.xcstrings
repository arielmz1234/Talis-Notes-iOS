        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil photo n’est utilisé que lorsque cet écran est ouvert. Les photos restent sur cette tablette."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera só é usada enquanto esta tela está aberta. As fotos ficam neste tablet."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُستخدم الكاميرا فقط أثناء فتح هذه الشاشة. تبقى الصور على هذا الجهاز اللوحي."
