    "every_notebook_the_app_backed_up": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every notebook the app backed up there. It keeps backing up there too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los cuadernos que la app copió allí. También sigue haciendo copias allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les carnets que l'appli y a sauvegardés. Elle continue aussi d'y sauvegarder."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os cadernos que o app salvou lá. Ele continua fazendo backup lá também."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل دفتر نسخه التطبيق هناك. ويواصل النسخ إلى هناك أيضًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל מחברת שהאפליקציה גיבתה שם. והגיבוי לשם ממשיך."
          }
        }
      }
    },
    "every_page_of_the_notebook_as": {
      "extractionState": "manual",
