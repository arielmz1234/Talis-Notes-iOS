    "a_pdf_or_pictures_from_your_files": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A PDF or pictures from your files"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un PDF o imágenes de tus archivos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un PDF ou des images de vos fichiers"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um PDF ou imagens dos seus arquivos"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف PDF أو صور من ملفاتك"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF או תמונות מהקבצים שלך"
          }
        }
      }
    },
    "a_pdf_you_open_with_tali": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A PDF you open with Tali's Notes goes straight into your notebooks, ready to write on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un PDF que abras con Tali's Notes va directo a tus cuadernos, listo para escribir en él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un PDF ouvert avec Tali's Notes va directement dans vos carnets, prêt à être annoté."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um PDF aberto com o Tali's Notes vai direto para seus cadernos, pronto para você escrever nele."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف PDF تفتحه باستخدام Tali's Notes يذهب مباشرة إلى دفاترك، جاهزًا للكتابة عليه."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קובץ PDF שנפתח ב-Tali's Notes נכנס ישר למחברות שלך, מוכן לכתיבה."
          }
        }
      }
    },
    "a_pdf_you_open_with_tali_2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A PDF you open with Tali's Notes opens just for looking. Tap Save to keep it and write on it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un PDF que abras con Tali's Notes se abre solo para mirarlo. Toca Guardar para conservarlo y escribir en él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un PDF ouvert avec Tali's Notes s'ouvre juste pour être consulté. Touchez Enregistrer pour le garder et écrire dessus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um PDF aberto com o Tali's Notes abre só para visualizar. Toque em Salvar para guardá-lo e escrever nele."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف PDF تفتحه باستخدام Tali's Notes يُفتح للعرض فقط. اضغط «حفظ» للاحتفاظ به والكتابة عليه."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קובץ PDF שנפתח ב-Tali's Notes נפתח לצפייה בלבד. אפשר להקיש על \"שמירה\" כדי לשמור אותו ולכתוב עליו."
          }
        }
      }
    },
