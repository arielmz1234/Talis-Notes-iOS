    "auto_backup_into_file_in_place": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves a fresh backup a couple of minutes after you finish, and once a day, into “%1$@” in %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda una copia nueva un par de minutos después de que termines, y una vez al día, en «%1$@» en %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre une nouvelle sauvegarde quelques minutes après que vous avez fini, et une fois par jour, dans « %1$@ » sur %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva um backup novo alguns minutos depois que você termina, e uma vez por dia, em “%1$@” no %2$@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ نسخة احتياطية جديدة بعد دقيقتين من انتهائك، ومرة كل يوم، في «%1$@» على %2$@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שומר גיבוי חדש כמה דקות אחרי שסיימת, ופעם ביום, בקובץ \"%1$@\" ב-%2$@."
          }
        }
      }
    },
    "auto_backup_into_file_on_tablet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves a fresh backup a couple of minutes after you finish, and once a day, into “%1$@” on this tablet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda una copia nueva un par de minutos después de que termines, y una vez al día, en «%1$@» en esta tableta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre une nouvelle sauvegarde quelques minutes après que vous avez fini, et une fois par jour, dans « %1$@ » sur cette tablette."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva um backup novo alguns minutos depois que você termina, e uma vez por dia, em “%1$@” neste tablet."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ نسخة احتياطية جديدة بعد دقيقتين من انتهائك، ومرة كل يوم، في «%1$@» على هذا الجهاز اللوحي."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שומר גיבוי חדש כמה דקות אחרי שסיימת, ופעם ביום, בקובץ \"%1$@\" בטאבלט הזה."
          }
        }
      }
    },
    "auto_backup_into_file_somewhere": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves a fresh backup a couple of minutes after you finish, and once a day, into “%1$@” in the place you chose."
