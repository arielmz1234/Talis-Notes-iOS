    "fainter_pictures_keep_your_writing_easy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fainter pictures keep your writing easy to read."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con imágenes más tenues, tu escritura se lee mejor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des images plus pâles gardent votre écriture lisible."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagens mais claras deixam sua escrita fácil de ler."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصور الباهتة تُبقي كتابتك سهلة القراءة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תמונות בהירות יותר שומרות על הכתיבה קריאה."
          }
        }
      }
    },
    "feat_box_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick something up with the lasso and tap the square in its menu. A rectangle is drawn around it with the pen you're using: its colour, thickness and line style."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toma algo con el lazo y toca el cuadrado de su menú. Se dibuja un rectángulo alrededor con el lápiz que estás usando: su color, grosor y tipo de línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez quelque chose avec le lasso et touchez le carré dans son menu. Un rectangle est tracé autour avec le stylo que vous utilisez : sa couleur, son épaisseur et son style de trait."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegue algo com o laço e toque no quadrado do menu. Um retângulo é desenhado em volta com a caneta que você está usando: sua cor, espessura e estilo de linha."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التقط شيئًا بأداة التحديد واضغط على المربع في قائمته. يُرسم مستطيل حوله بالقلم الذي تستخدمه: بلونه وسُمكه ونمط خطه."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בוחרים משהו עם הלאסו ומקישים על הריבוע בתפריט שלו. מלבן מצויר סביבו עם העט שבשימוש: הצבע, העובי וסגנון הקו שלו."
          }
        }
      }
    },
    "feat_box_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A box around anything"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un recuadro alrededor de todo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cadre autour de tout"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma caixa em volta de tudo"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إطار حول أي شيء"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסגרת סביב כל דבר"
          }
        }
      }
    },
    "feat_circle_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Circle to select in a pen's settings. Draw a loop around something, then press the pen on the loop and hold: it glows and picks up what's inside, with no change of tool."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Rodear para seleccionar en los ajustes de un lápiz. Dibuja un lazo alrededor de algo, luego apoya el lápiz sobre el lazo y mantenlo: brilla y toma lo que hay dentro, sin cambiar de herramienta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Entourer pour sélectionner dans les réglages d’un stylo. Tracez une boucle autour de quelque chose, puis appuyez le stylet sur la boucle et maintenez : elle s’illumine et prend ce qu’elle entoure, sans changer d’outil."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative Circular para selecionar nas configurações de uma caneta. Desenhe um laço em volta de algo, depois encoste a caneta no laço e segure: ele brilha e pega o que está dentro, sem trocar de ferramenta."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل «أحِط للتحديد» في إعدادات القلم. ارسم حلقة حول شيء، ثم اضغط بالقلم على الحلقة واستمر: تتوهج وتلتقط ما بداخلها دون تغيير الأداة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפעילים את הקפה לבחירה בהגדרות של עט. מציירים לולאה סביב משהו, ואז לוחצים בעט על הלולאה ומחזיקים: היא זוהרת ובוחרת את מה שבתוכה, בלי להחליף כלי."
          }
        }
      }
    },
    "feat_circle_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Circle to select"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodear para seleccionar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entourer pour sélectionner"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Circular para selecionar"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أحِط للتحديد"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקפה לבחירה"
          }
        }
      }
    },
    "feat_colours_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Settings, choose Lilac, Sky, Sage or Peach, in light or dark, with a Cloudy or Minimal style."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Ajustes, elige Lila, Cielo, Salvia o Melocotón, en claro u oscuro, con estilo Nubes o Minimalista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Réglages, choisissez Lilas, Ciel, Sauge ou Pêche, en clair ou en sombre, avec le style Nuages ou Épuré."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em Configurações, escolha Lilás, Céu, Sálvia ou Pêssego, no claro ou no escuro, com estilo Nuvens ou Minimalista."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من الإعدادات، اختر ليلكي أو سماوي أو أخضر هادئ أو خوخي، بالوضع الفاتح أو الداكن، مع نمط غيوم أو بسيط."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בהגדרות בוחרים לילך, שמיים, מרווה או אפרסק, בהיר או כהה, בסגנון עננים או מינימלי."
          }
        }
      }
    },
    "feat_colours_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a colour family"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una familia de colores"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir une famille de couleurs"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma família de cores"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر عائلة ألوان"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחירת משפחת צבעים"
          }
        }
      }
    },
    "feat_dots_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a shape to see its dots. Drag a circle's dot to change its radius, a part circle's ends to choose how much of a circle, a triangle's corners for its angles. The badge shows centimetres and degrees."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una forma para ver sus puntos. Arrastra el punto de un círculo para cambiar su radio, los extremos de un sector para elegir cuánto círculo, las esquinas de un triángulo para sus ángulos. La etiqueta muestra centímetros y grados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une forme pour voir ses points. Faites glisser le point d’un cercle pour changer son rayon, les bouts d’un secteur pour choisir la part du cercle, les coins d’un triangle pour ses angles. L’étiquette indique centimètres et degrés."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque numa forma para ver seus pontos. Arraste o ponto de um círculo para mudar o raio, as pontas de um setor para escolher quanto do círculo, os cantos de um triângulo para os ângulos. A etiqueta mostra centímetros e graus."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على شكل لترى نقاطه. اسحب نقطة الدائرة لتغيير نصف قطرها، وطرفي القطاع لاختيار مقدار الدائرة، وزوايا المثلث لزواياه. تعرض الشارة السنتيمترات والدرجات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מקישים על צורה כדי לראות את הנקודות שלה. גוררים את הנקודה של עיגול כדי לשנות את הרדיוס, את הקצוות של גזרה כדי לבחור כמה מהעיגול, ואת הפינות של משולש בשביל הזוויות. התווית מציגה סנטימטרים ומעלות."
          }
        }
      }
    },
    "feat_dots_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change a shape with its dots"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia una forma con sus puntos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifier une forme par ses points"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mude uma forma pelos pontos"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غيّر الشكل بنقاطه"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שינוי צורה בעזרת הנקודות"
          }
        }
      }
    },
    "feat_fill_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the fill tool and tap inside any closed shape, even an outline you drew by hand. Choose the colour and how see-through it is in the tool's panel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la herramienta de relleno y toca dentro de cualquier forma cerrada, incluso un contorno dibujado a mano. Elige el color y su transparencia en el panel de la herramienta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez l’outil de remplissage et touchez l’intérieur de n’importe quelle forme fermée, même un contour tracé à la main. Choisissez la couleur et sa transparence dans le panneau de l’outil."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a ferramenta de preenchimento e toque dentro de qualquer forma fechada, até um contorno desenhado à mão. Escolha a cor e a transparência no painel da ferramenta."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر أداة التعبئة واضغط داخل أي شكل مغلق، حتى لو رسمت حدوده بيدك. اختر اللون ودرجة الشفافية من لوحة الأداة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בוחרים את כלי המילוי ומקישים בתוך כל צורה סגורה, גם קו מתאר שצויר ביד. את הצבע ואת השקיפות בוחרים בחלונית של הכלי."
          }
        }
      }
    },
    "feat_fill_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill a shape"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rellena una forma"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplir une forme"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preencha uma forma"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "املأ شكلًا"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מילוי צורה"
          }
        }
      }
    },
    "feat_fingers_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the page with two fingers to undo, and with three fingers to redo. You can turn this off in the ⋯ menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca la página con dos dedos para deshacer y con tres para rehacer. Puedes desactivarlo en el menú ⋯."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez la page avec deux doigts pour annuler, et avec trois pour rétablir. Vous pouvez le désactiver dans le menu ⋯."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque na página com dois dedos para desfazer e com três para refazer. Dá para desligar isso no menu ⋯."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المس الصفحة بإصبعين للتراجع، وبثلاثة أصابع للإعادة. يمكنك إيقاف ذلك من القائمة ⋯."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקשה על העמוד בשתי אצבעות מבטלת, ובשלוש אצבעות מבצעת שוב. אפשר לכבות את זה בתפריט ⋯."
          }
        }
      }
    },
    "feat_fingers_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo with your fingers"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deshacer con los dedos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler avec les doigts"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desfazer com os dedos"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تراجع بأصابعك"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ביטול באצבעות"
          }
        }
      }
    },
    "feat_laser_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the laser to point things out while you explain. It stays lit while you draw and fades away a moment after you stop. Nothing is saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el láser para señalar mientras explicas. Se mantiene encendido mientras dibujas y se desvanece un momento después de parar. No se guarda nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le laser pour montrer des choses pendant que vous expliquez. Il reste allumé tant que vous tracez et s’efface un instant après. Rien n’est enregistré."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o laser para apontar coisas enquanto explica. Ele fica aceso enquanto você desenha e some um instante depois que você para. Nada é salvo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر الليزر للإشارة إلى الأشياء أثناء الشرح. يبقى مضيئًا ما دمت ترسم ويتلاشى بعد لحظة من توقفك. لا يُحفظ شيء."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בוחרים בלייזר כדי להצביע על דברים תוך כדי הסבר. הוא נשאר דולק כל עוד מציירים ונעלם רגע אחרי שמפסיקים. שום דבר לא נשמר."
          }
        }
      }
    },
    "feat_laser_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Laser pointer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puntero láser"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointeur laser"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponteiro laser"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مؤشر الليزر"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצביע לייזר"
          }
        }
      }
    },
    "feat_lock_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick something up, open the rest of its menu (›) and tap the lock. Locked things can't be moved or erased by accident. Hold a finger on one to unlock it, or use Unlock all in the ⋯ menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toma algo, abre el resto de su menú (›) y toca el candado. Lo bloqueado no se mueve ni se borra por accidente. Mantén un dedo encima para desbloquearlo, o usa Desbloquear todo en el menú ⋯."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez quelque chose, ouvrez la suite de son menu (›) et touchez le cadenas. Ce qui est verrouillé ne bouge pas et ne s’efface pas par erreur. Maintenez un doigt dessus pour le déverrouiller, ou utilisez Tout déverrouiller dans le menu ⋯."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegue algo, abra o resto do menu (›) e toque no cadeado. O que está travado não se move nem se apaga sem querer. Segure um dedo em cima para destravar, ou use Destravar tudo no menu ⋯."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التقط شيئًا وافتح بقية قائمته (›) واضغط على القفل. لا يتحرك المقفل ولا يُمسح بالخطأ. اترك إصبعك عليه قليلًا لفتحه، أو استخدم «فتح الكل» من القائمة ⋯."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בוחרים משהו, פותחים את שאר התפריט שלו (›) ומקישים על המנעול. דברים נעולים לא זזים ולא נמחקים בטעות. כדי לשחרר, מחזיקים עליהם אצבע לרגע, או משתמשים בשחרור הכול בתפריט ⋯."
          }
        }
      }
    },
    "feat_lock_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock things in place"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fija cosas en su sitio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouiller en place"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trave as coisas no lugar"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّت الأشياء في مكانها"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נעילה במקום"
          }
        }
      }
    },
    "feat_pages_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the page number at the bottom to see every page. Hold a page and drag it to move it, or tap Select to duplicate or delete several at once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el número de página abajo para ver todas las páginas. Mantén una página y arrástrala para moverla, o toca Seleccionar para duplicar o eliminar varias a la vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le numéro de page en bas pour voir toutes les pages. Maintenez une page et faites-la glisser pour la déplacer, ou touchez Sélectionner pour en dupliquer ou supprimer plusieurs à la fois."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no número da página embaixo para ver todas. Segure uma página e arraste para movê-la, ou toque em Selecionar para duplicar ou excluir várias de uma vez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على رقم الصفحة في الأسفل لترى كل الصفحات. اضغط مطولًا على صفحة واسحبها لنقلها، أو اضغط «تحديد» لتكرار عدة صفحات أو حذفها معًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מקישים על מספר העמוד למטה כדי לראות את כל העמודים. מחזיקים עמוד וגוררים כדי להזיז אותו, או מקישים על בחירה כדי לשכפל או למחוק כמה בבת אחת."
          }
        }
      }
    },
    "feat_pages_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrange your pages"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordena tus páginas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Organiser vos pages"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Organize suas páginas"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رتّب صفحاتك"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סידור העמודים"
          }
        }
      }
    },
    "feat_paste_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy or cut something, then hold the pen or a finger still anywhere on the page: a Paste bubble appears right there. Pictures and text copied in other apps paste the same way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia o corta algo y luego mantén el lápiz o un dedo quieto en cualquier parte de la página: aparece una burbuja Pegar justo ahí. Las imágenes y el texto copiados en otras apps se pegan igual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiez ou coupez quelque chose, puis gardez le stylet ou un doigt immobile n’importe où sur la page : une bulle Coller apparaît juste là. Les images et le texte copiés dans d’autres applis se collent de la même façon."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie ou recorte algo e depois segure a caneta ou um dedo parado em qualquer lugar da página: uma bolha Colar aparece ali mesmo. Imagens e textos copiados em outros apps são colados do mesmo jeito."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انسخ شيئًا أو قصّه، ثم اترك القلم أو إصبعك ثابتًا في أي مكان من الصفحة: تظهر فقاعة «لصق» هناك. الصور والنصوص المنسوخة من تطبيقات أخرى تُلصق بالطريقة نفسها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעתיקים או גוזרים משהו, ואז מחזיקים את העט או אצבע במקום כלשהו בעמוד: בועת הדבקה מופיעה בדיוק שם. תמונות וטקסט שהועתקו באפליקציות אחרות מודבקים באותה דרך."
          }
        }
      }
    },
    "feat_paste_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold to paste"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén para pegar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenir pour coller"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure para colar"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا للصق"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחיצה ארוכה להדבקה"
          }
        }
      }
    },
    "feat_quick_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The button with the little clock, beside Back, lists your recent notebooks. One tap switches, and Back still takes you to the library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El botón con el relojito, junto a Atrás, muestra tus cuadernos recientes. Un toque cambia de cuaderno, y Atrás sigue llevándote a la biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bouton à la petite horloge, à côté de Retour, liste vos cahiers récents. Un toucher pour changer, et Retour mène toujours à la bibliothèque."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O botão com o reloginho, ao lado de Voltar, lista seus cadernos recentes. Um toque troca, e Voltar continua levando à biblioteca."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الزر ذو الساعة الصغيرة بجانب زر الرجوع يعرض دفاترك الأخيرة. لمسة واحدة للتبديل، ويبقى زر الرجوع يأخذك إلى المكتبة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכפתור עם השעון הקטן, ליד חזרה, מציג את המחברות האחרונות. הקשה אחת מחליפה, וחזרה עדיין מובילה לספרייה."
          }
        }
      }
    },
    "feat_quick_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jump between notebooks"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta entre cuadernos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passer d’un cahier à l’autre"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pule entre cadernos"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنقّل بين الدفاتر"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעבר מהיר בין מחברות"
          }
        }
      }
    },
    "feat_room_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The eye hides the toolbars. In the ⋯ menu, Full screen hides the tablet's bars too, and Write between pages lets a stroke carry on from one page to the next."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ojo oculta las barras de herramientas. En el menú ⋯, Pantalla completa oculta también las barras de la tableta, y Escribir entre páginas deja que un trazo siga de una página a la siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’œil masque les barres d’outils. Dans le menu ⋯, Plein écran masque aussi les barres de la tablette, et Écrire entre les pages laisse un trait passer d’une page à la suivante."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O olho esconde as barras de ferramentas. No menu ⋯, Tela cheia esconde também as barras do tablet, e Escrever entre as páginas deixa um traço seguir de uma página para a próxima."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العين تخفي أشرطة الأدوات. ومن القائمة ⋯، يخفي «ملء الشاشة» أشرطة الجهاز أيضًا، ويسمح «الكتابة بين الصفحات» للخط بأن يمتد من صفحة إلى التالية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העין מסתירה את סרגלי הכלים. בתפריט ⋯, מסך מלא מסתיר גם את הסרגלים של הטאבלט, וכתיבה בין עמודים מאפשרת לקו להמשיך מעמוד לעמוד הבא."
          }
        }
      }
    },
    "feat_room_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More room to write"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más espacio para escribir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus de place pour écrire"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais espaço para escrever"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مساحة أكبر للكتابة"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יותר מקום לכתוב"
          }
        }
      }
    },
    "feat_shot_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Screenshot in the lasso's panel, then draw around anything. Copy it, save it to the gallery or share it, sharp even when zoomed out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Captura en el panel del lazo y dibuja alrededor de lo que quieras. Cópiala, guárdala en la galería o compártela, nítida aunque estés alejado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Capture dans le panneau du lasso, puis entourez ce que vous voulez. Copiez-la, enregistrez-la dans la galerie ou partagez-la, nette même en vue éloignée."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative Captura no painel do laço e desenhe em volta do que quiser. Copie, salve na galeria ou compartilhe, nítida mesmo com o zoom afastado."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل «لقطة شاشة» في لوحة أداة التحديد، ثم ارسم حول ما تريد. انسخها أو احفظها في المعرض أو شاركها، واضحة حتى عند التصغير."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפעילים את צילום מסך בחלונית של הלאסו, ואז מקיפים כל דבר. אפשר להעתיק, לשמור בגלריה או לשתף, חד גם כשהתצוגה מוקטנת."
          }
        }
      }
    },
    "feat_shot_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshot part of a page"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura una parte de la página"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturer une partie de la page"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture parte da página"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التقط جزءًا من الصفحة"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צילום מסך של חלק מהעמוד"
          }
        }
      }
    },
    "feat_star_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold a notebook and choose Star. Starred notebooks get their own place in the sidebar, under All notebooks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén un cuaderno y elige Destacar. Los cuadernos destacados tienen su propio lugar en la barra lateral, bajo Todos los cuadernos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez un cahier et choisissez Ajouter une étoile. Les cahiers favoris ont leur propre place dans la barre latérale, sous Tous les cahiers."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure um caderno e escolha Marcar com estrela. Os cadernos marcados ganham um lugar próprio na barra lateral, abaixo de Todos os cadernos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا على دفتر واختر «تمييز بنجمة». للدفاتر المميزة مكان خاص في الشريط الجانبي، تحت كل الدفاتر."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחזיקים מחברת ובוחרים סימון בכוכב. למחברות המסומנות יש מקום משלהן בסרגל הצד, מתחת לכל המחברות."
          }
        }
      }
    },
    "feat_star_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Star your notebooks"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Destaca tus cuadernos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre vos cahiers en favoris"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque seus cadernos"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ميّز دفاترك بنجمة"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סימון מחברות בכוכב"
          }
        }
      }
    },
    "feat_starpens_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the star in a pen's settings. With the S Pen near the screen, press its button twice for the next starred pen, or three times to go back. Hold the button to erase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca la estrella en los ajustes de un lápiz. Con el S Pen cerca de la pantalla, pulsa su botón dos veces para ir al siguiente lápiz destacado, o tres para volver. Mantén el botón para borrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez l’étoile dans les réglages d’un stylo. Le S Pen près de l’écran, appuyez deux fois sur son bouton pour passer au stylo favori suivant, ou trois fois pour revenir. Maintenez le bouton pour gommer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque na estrela nas configurações de uma caneta. Com a S Pen perto da tela, aperte o botão duas vezes para ir à próxima caneta favorita, ou três para voltar. Segure o botão para apagar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على النجمة في إعدادات القلم. وقلم S Pen قريب من الشاشة، اضغط زره مرتين للانتقال إلى القلم المميز التالي، أو ثلاث مرات للرجوع. اضغط الزر مطولًا للمسح."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מקישים על הכוכב בהגדרות של עט. כשה-S Pen קרוב למסך, לוחצים על הכפתור שלו פעמיים כדי לעבור לעט המסומן הבא, או שלוש פעמים כדי לחזור. החזקת הכפתור מוחקת."
          }
        }
      }
    },
    "feat_starpens_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
