    "part_circle_drag_from_the_centre": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Part circle: drag from the centre outwards; it starts as a half. Then drag an end dot to make it any % of a circle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sector circular: arrastra desde el centro hacia fuera; empieza como un semicírculo. Luego arrastra un punto del extremo para que sea cualquier % de un círculo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Secteur : faites glisser du centre vers l'extérieur ; il commence en demi-cercle. Puis faites glisser un point d'extrémité pour en faire n'importe quel % d'un cercle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Setor circular: arraste do centro para fora; ele começa como meio círculo. Depois arraste um ponto da ponta para que seja qualquer % de um círculo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قطاع دائري: اسحب من المركز إلى الخارج؛ يبدأ نصف دائرة. ثم اسحب نقطة الطرف لجعله أي نسبة % من الدائرة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חלק מעיגול: גוררים מהמרכז החוצה; מתחיל כחצי. אחר כך גוררים נקודת קצה כדי לקבוע כל אחוז מהעיגול."
          }
        }
      }
    },
